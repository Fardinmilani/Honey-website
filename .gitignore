# =============================================================================
# Honey Website — root .gitignore
# -----------------------------------------------------------------------------
# Rules are evaluated top to bottom; the LAST matching pattern wins.
# The "ALWAYS TRACKED" guard block at the bottom is intentionally last so that
# protected paths (Hero media, Prisma migrations, docs, Cursor rules, the pnpm
# lockfile and production Docker configuration) can never be excluded by a
# broader rule added above it.
#
# Deliberate exclusion/inclusion pairs worth knowing about:
#   *.sql        is ignored (local dumps) BUT prisma/migrations/**/*.sql is not.
#   .env*        is ignored (secrets)     BUT .env.example is not.
#   .cursor/*    is ignored (scratch)     BUT .cursor/rules/ is not.
#   raw masters  are ignored (*.mov, ...) BUT apps/web/public/media/ is not.
# =============================================================================


# -----------------------------------------------------------------------------
# Dependencies and package-manager caches
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.pnpm/
.npm/
.yarn/cache/
.yarn/install-state.gz
.yarn/unplugged/
.yarn/build-state.yml
.node_repl_history
*.tgz
package-lock.json
yarn.lock
npm-shrinkwrap.json


# -----------------------------------------------------------------------------
# Build outputs — Next.js
# -----------------------------------------------------------------------------
.next/
out/
.vercel/
.netlify/
next-env.d.ts
apps/web/.next/
apps/web/out/


# -----------------------------------------------------------------------------
# Build outputs — NestJS / Node / bundlers
# -----------------------------------------------------------------------------
dist/
build/
.output/
.nest/
apps/api/dist/
apps/worker/dist/
packages/*/dist/


# -----------------------------------------------------------------------------
# Build outputs — Turborepo
# -----------------------------------------------------------------------------
.turbo/
**/.turbo/
turbo-*.log


# -----------------------------------------------------------------------------
# Build outputs — TypeScript
# -----------------------------------------------------------------------------
*.tsbuildinfo
tsconfig.tsbuildinfo
**/*.tsbuildinfo
.tscache/


# -----------------------------------------------------------------------------
