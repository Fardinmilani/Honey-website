!docker/local/**


# =============================================================================
# ALWAYS TRACKED — protected paths (must remain the last block in this file)
# Adding rules AFTER this block can silently break repository guarantees.
# =============================================================================
!.gitignore
!.gitattributes
!.editorconfig
!.env.example
!pnpm-lock.yaml
!pnpm-workspace.yaml
!AGENTS.md
!PLANS.md
!docs/
!docs/**
!.cursor/rules/
!.cursor/rules/**
!**/prisma/migrations/
!**/prisma/migrations/**
!apps/web/public/media/
!apps/web/public/media/**
!Dockerfile
!**/Dockerfile
!**/Dockerfile.*
!.dockerignore
!docker-compose.yml
!docker-compose.prod.yml
!docker-compose.prod.yaml
!docker/prod/
!docker/prod/**
!infra/docker/prod/
!infra/docker/prod/**
