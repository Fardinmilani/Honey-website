{
  "name": "honey-website",
  "version": "0.0.0",
  "private": true,
  "description": "Bilingual single-brand honey commerce platform workspace.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "22.17.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0 && turbo run lint",
    "boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "node --test tools/boundaries/checker.test.mjs && turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "phase2:verify": "node scripts/verify-phase2.mjs",
    "docker:up": "docker compose config --quiet && docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "docker:status": "docker compose ps -a",
    "docker:reset": "node scripts/docker-reset.mjs",
    "docker:verify": "node scripts/docker-verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "prettier": "3.9.0",
    "turbo": "2.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
