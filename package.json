{
  "name": "honey-website",
  "version": "0.0.0",
  "private": true,
  "description": "Bilingual single-brand honey commerce platform workspace.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "22.17.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0 && turbo run lint",
    "boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "node --test tools/boundaries/checker.test.mjs && turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "phase2:verify": "node scripts/verify-phase2.mjs",
    "docker:up": "docker compose config --quiet && docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "docker:status": "docker compose ps -a",
    "docker:reset": "node scripts/docker-reset.mjs",
    "docker:verify": "node scripts/docker-verify.mjs",
    "db:format": "pnpm --filter @honey/db prisma:format",
    "db:validate": "pnpm --filter @honey/db prisma:validate",
    "db:generate": "pnpm --filter @honey/db prisma:generate",
    "db:migrate": "pnpm --filter @honey/db db:migrate",
    "db:migrate:status": "pnpm --filter @honey/db db:migrate:status",
    "db:seed": "pnpm --filter @honey/db db:seed",
    "db:test": "pnpm --filter @honey/db db:test",
    "forbidden-vocabulary": "node scripts/verify-forbidden-vocabulary.mjs",
    "phase4:verify": "pnpm db:validate && pnpm db:generate && pnpm forbidden-vocabulary && pnpm boundaries && node scripts/verify-phase4.mjs",
    "api:dev": "pnpm --filter @honey/api dev",
    "api:start": "pnpm --filter @honey/api start",
    "api:test": "pnpm --filter @honey/api test",
    "api:test:integration": "pnpm --filter @honey/api test:integration",
    "api:openapi:generate": "pnpm --filter @honey/api openapi:generate && pnpm --filter @honey/contracts types:generate",
    "api:openapi:check": "pnpm --filter @honey/api openapi:check && pnpm --filter @honey/contracts types:check",
    "api:openapi:lint": "pnpm --filter @honey/contracts openapi:lint",
    "api:openapi:forbidden": "pnpm --filter @honey/contracts openapi:forbidden",
    "api:openapi:breaking": "pnpm --filter @honey/contracts openapi:breaking",
    "api:docker:build": "docker build --file docker/api.Dockerfile --tag honey-api:phase5 .",
    "phase5:verify": "node scripts/verify-phase5.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "prettier": "3.9.0",
    "turbo": "2.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
