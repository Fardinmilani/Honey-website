generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum CredentialType {
  PASSWORD
  TOTP
  RECOVERY_CODE

  @@map("credential_type")
}

enum SessionKind {
  CUSTOMER
  STAFF

  @@map("session_kind")
}

enum VerificationPurpose {
  EMAIL
  PHONE
  PASSWORD_RESET

  @@map("verification_purpose")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("product_status")
}

enum VariantStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("variant_status")
}

enum SourcingType {
  OWN_PRODUCTION
  SELECTED_SUPPLIER

  @@map("sourcing_type")
}

enum MediaRole {
  GALLERY
  THUMBNAIL
  LIFESTYLE
  VIDEO

  @@map("media_role")
}

enum SupplierStatus {
  ACTIVE
  PAUSED
  BLOCKED

  @@map("supplier_status")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

enum StockLocationType {
  WAREHOUSE
  STUDIO
  EXTERNAL

  @@map("stock_location_type")
}

enum StockLedgerReason {
  RECEIPT
  RESERVATION
  RESERVATION_RELEASE
  ALLOCATION
  FULFILMENT
  RETURN
  ADJUSTMENT
  WRITE_OFF
  TRANSFER_IN
  TRANSFER_OUT
  CORRECTION

  @@map("stock_ledger_reason")
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED

  @@map("reservation_status")
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING

  @@map("coupon_type")
}

enum CouponAppliesTo {
  ALL
  CATEGORY
  COLLECTION
  VARIANT

  @@map("coupon_applies_to")
}

enum CouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED

  @@map("coupon_status")
}

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
  ABANDONED

  @@map("cart_status")
}

enum CheckoutStatus {
  OPEN
  AWAITING_PAYMENT
  COMPLETED
  EXPIRED
  CANCELLED

  @@map("checkout_status")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED

  @@map("order_status")
}

enum OrderPaymentStatus {
  UNPAID
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED

  @@map("order_payment_status")
}

enum FulfilmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED

  @@map("fulfilment_status")
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  RESOLVED

  @@map("return_request_status")
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum PaymentAttemptStatus {
  CREATED
  SENT
  SUCCEEDED
  FAILED

  @@map("payment_attempt_status")
}

enum PaymentTransactionType {
  AUTHORIZE
  CAPTURE
  REFUND
  VOID
  CHARGEBACK

  @@map("payment_transaction_type")
}

enum PaymentOutcomeSource {
  VERIFIED_WEBHOOK
  VERIFIED_RETURN
  RECONCILIATION

  @@map("payment_outcome_source")
}

enum RefundStatus {
  REQUESTED
  PENDING
  COMPLETED
  FAILED
  CANCELLED

  @@map("refund_status")
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED

  @@map("shipment_status")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

model User {
  id                 String               @id @db.Uuid
  email              String               @unique @db.Citext
  emailVerifiedAt    DateTime?            @map("email_verified_at") @db.Timestamptz(3)
  phone              String?
  phoneVerifiedAt    DateTime?            @map("phone_verified_at") @db.Timestamptz(3)
  displayName        String?              @map("display_name")
  preferredLocale    String               @default("fa") @map("preferred_locale")
  status             UserStatus           @default(ACTIVE)
  isStaff            Boolean              @default(false) @map("is_staff")
  lastLoginAt        DateTime?            @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?              @map("created_by") @db.Uuid
  updatedBy          String?              @map("updated_by") @db.Uuid
  credentials        AuthCredential[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  userRoles          UserRole[]           @relation("UserRoles")
  grantedRoles       UserRole[]           @relation("GrantedRoles")
  auditLogs          AuditLog[]           @relation("AuditActor")
  addresses          Address[]
  carts              Cart[]
  checkoutSessions   CheckoutSession[]
  orders             Order[]
  couponRedemptions  CouponRedemption[]
  orderStatusChanges OrderStatusHistory[]
  orderNotes         OrderNote[]
  requestedRefunds   Refund[]
  idempotencyKeys    IdempotencyKey[]

  @@map("user")
}

model AuthCredential {
  id               String         @id @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  type             CredentialType
  secretHash       String?        @map("secret_hash")
  encryptedSecret  Bytes?         @map("encrypted_secret") @db.ByteA
  secretNonce      Bytes?         @map("secret_nonce") @db.ByteA
  secretTag        Bytes?         @map("secret_tag") @db.ByteA
  lastAcceptedStep BigInt?        @map("last_accepted_step")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?      @map("last_used_at") @db.Timestamptz(3)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([userId])
  @@map("auth_credential")
}

model Session {
  id                String      @id @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  kind              SessionKind
  tokenHash         String      @unique @map("token_hash")
  ip                String?     @db.Inet
  userAgentHash     String?     @map("user_agent_hash")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime    @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime    @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?   @map("revoked_at") @db.Timestamptz(3)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([userId, expiresAt])
  @@map("session")
}

model VerificationToken {
  id         String              @id @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  purpose    VerificationPurpose
  tokenHash  String              @unique @map("token_hash")
  expiresAt  DateTime            @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?           @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_token")
}

model Role {
  id              String           @id @db.Uuid
  code            String           @unique
  name            String
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  @@map("role")
}

model Permission {
  id              String           @id @db.Uuid
  code            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("permission")
}

model RolePermission {
  id           String     @id @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model UserRole {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  user      User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantor   User?    @relation("GrantedRoles", fields: [grantedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([grantedBy])
  @@map("user_role")
}

model AuditLog {
  id          String   @id @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  beforeJson  Json?    @map("before_json") @db.JsonB
  afterJson   Json?    @map("after_json") @db.JsonB
  ip          String?  @db.Inet
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([actorUserId])
  @@index([subjectType, subjectId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model Product {
  id                 String               @id @db.Uuid
  sku                String?              @unique
  brandLine          String?              @map("brand_line")
  status             ProductStatus        @default(DRAFT)
  publishedAt        DateTime?            @map("published_at") @db.Timestamptz(3)
  primaryCategoryId  String?              @map("primary_category_id") @db.Uuid
  defaultVariantId   String?              @unique @map("default_variant_id") @db.Uuid
  honeyVarietal      String?              @map("honey_varietal")
  floralSources      String[]             @default([]) @map("floral_sources")
  originRegion       String?              @map("origin_region")
  originAltitudeBand String?              @map("origin_altitude_band")
  harvestSeason      String?              @map("harvest_season")
  apiaryId           String?              @map("apiary_id") @db.Uuid
  sourcingType       SourcingType         @map("sourcing_type")
  sortWeight         Int                  @default(0) @map("sort_weight")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String?              @map("created_by") @db.Uuid
  updatedBy          String?              @map("updated_by") @db.Uuid
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(3)
  primaryCategory    Category?            @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  defaultVariant     ProductVariant?      @relation("DefaultVariant", fields: [defaultVariantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  apiary             Apiary?              @relation(fields: [apiaryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  translations       ProductTranslation[]
  variants           ProductVariant[]     @relation("ProductVariants")
  categories         ProductCategory[]
  collections        ProductCollection[]
  media              ProductMedia[]
  orderLines         OrderLine[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([primaryCategoryId, status])
  @@index([apiaryId])
  @@map("product")
}

model ProductTranslation {
  id                 String  @id @db.Uuid
  productId          String  @map("product_id") @db.Uuid
  locale             String
  name               String
  slug               String
  shortDescription   String? @map("short_description")
  description        String?
  tastingNotes       String? @map("tasting_notes")
  pairingSuggestions String? @map("pairing_suggestions")
  storyHtml          String? @map("story_html")
  metaTitle          String? @map("meta_title")
  metaDescription    String? @map("meta_description")
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([productId])
  @@map("product_translation")
}

model ProductVariant {
  id                  String               @id @db.Uuid
  productId           String               @map("product_id") @db.Uuid
  sku                 String               @unique
  status              VariantStatus        @default(DRAFT)
  netWeightGrams      Int                  @map("net_weight_grams")
  jarSizeLabelKey     String               @map("jar_size_label_key")
  packagingTypeKey    String               @map("packaging_type_key")
  barcode             String?              @unique
  weightGramsShipping Int                  @map("weight_grams_shipping")
  dimensionsMm        Int[]                @default([]) @map("dimensions_mm")
  position            Int                  @default(0)
  isDefault           Boolean              @default(false) @map("is_default")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy           String?              @map("created_by") @db.Uuid
  updatedBy           String?              @map("updated_by") @db.Uuid
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  product             Product              @relation("ProductVariants", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  defaultForProduct   Product?             @relation("DefaultVariant")
  translations        VariantTranslation[]
  media               ProductMedia[]
  inventoryItems      InventoryItem[]
  ledgerEntries       StockLedgerEntry[]
  reservations        StockReservation[]
  prices              VariantPrice[]
  cartLines           CartLine[]
  batchAllocations    BatchAllocation[]
  purchaseOrderLines  PurchaseOrderLine[]
  orderLines          OrderLine[]

  @@index([productId, position])
  @@map("product_variant")
}

model VariantTranslation {
  id        String         @id @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  locale    String
  name      String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([variantId, locale])
  @@index([variantId])
  @@map("variant_translation")
}

model Category {
  id                String                @id @db.Uuid
  parentId          String?               @map("parent_id") @db.Uuid
  path              String
  sortWeight        Int                   @default(0) @map("sort_weight")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy         String?               @map("created_by") @db.Uuid
  updatedBy         String?               @map("updated_by") @db.Uuid
  deletedAt         DateTime?             @map("deleted_at") @db.Timestamptz(3)
  parent            Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children          Category[]            @relation("CategoryTree")
  translations      CategoryTranslation[]
  products          ProductCategory[]
  primaryForProduct Product[]             @relation("PrimaryCategory")

  @@unique([path])
  @@index([parentId])
  @@map("category")
}

model CategoryTranslation {
  id              String   @id @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  locale          String
  name            String
  slug            String
  description     String?
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([categoryId])
  @@map("category_translation")
}

model Collection {
  id           String                  @id @db.Uuid
  status       PublishStatus           @default(DRAFT)
  sortWeight   Int                     @default(0) @map("sort_weight")
  publishedAt  DateTime?               @map("published_at") @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    String?                 @map("created_by") @db.Uuid
  updatedBy    String?                 @map("updated_by") @db.Uuid
  deletedAt    DateTime?               @map("deleted_at") @db.Timestamptz(3)
  translations CollectionTranslation[]
  products     ProductCollection[]

  @@index([status, publishedAt(sort: Desc)])
  @@map("collection")
}

model CollectionTranslation {
  id              String     @id @db.Uuid
  collectionId    String     @map("collection_id") @db.Uuid
  locale          String
  name            String
  slug            String
  description     String?
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([collectionId, locale])
  @@unique([locale, slug])
  @@index([collectionId])
  @@map("collection_translation")
}

model ProductCategory {
  id         String   @id @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([productId, categoryId])
  @@index([categoryId, productId])
  @@map("product_category")
}

model ProductCollection {
  id           String     @id @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([productId, collectionId])
  @@index([collectionId, position])
  @@map("product_collection")
}

model SlugHistory {
  id         String   @id @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  locale     String
  oldSlug    String   @map("old_slug")
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([entityType, locale, oldSlug])
  @@index([entityId])
  @@map("slug_history")
}

model MediaAsset {
  id              String            @id @db.Uuid
  storageKey      String            @unique @map("storage_key")
  mimeType        String            @map("mime_type")
  bytes           BigInt
  width           Int?
  height          Int?
  durationSeconds Int?              @map("duration_seconds")
  checksum        String            @unique
  altTextByLocale Json?             @map("alt_text_by_locale") @db.JsonB
  createdBy       String?           @map("created_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
