{
  "name": "@honey/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "lint": "eslint src scripts test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "types:generate": "node scripts/generate-types.mjs",
    "types:check": "node scripts/generate-types.mjs --check",
    "openapi:lint": "spectral lint openapi.json --ruleset .spectral.yaml --fail-severity=warn",
    "openapi:forbidden": "node scripts/check-forbidden.mjs",
    "openapi:breaking": "node scripts/check-breaking.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@honey/core": "workspace:*"
  },
  "devDependencies": {
    "@honey/config-ts": "workspace:*",
    "@pb33f/openapi-changes": "0.2.7",
    "@stoplight/spectral-cli": "6.16.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.0"
  }
}
