      "post": {
        "description": "Signs only the stored key of an authorized private media asset.",
        "operationId": "createPrivateMediaUrl",
        "parameters": [
          {
            "in": "path",
            "name": "assetId",
            "required": true,
            "schema": { "format": "uuid", "type": "string" }
