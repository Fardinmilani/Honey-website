{
  "components": {
    "schemas": {
      "AcceptedResponseDto": {
        "properties": { "accepted": { "example": true, "type": "boolean" } },
        "required": ["accepted"],
        "type": "object"
      },
      "AuthenticatedResponseDto": {
        "properties": {
          "csrfToken": { "description": "Double-submit value for X-CSRF-Token.", "type": "string" },
          "expiresAt": { "format": "date-time", "type": "string" },
          "next": { "enum": ["AUTHENTICATED"], "type": "string" },
          "user": { "$ref": "#/components/schemas/SafeUserDto" }
        },
        "required": ["next", "user", "expiresAt", "csrfToken"],
        "type": "object"
      },
      "DirectUploadDto": {
        "properties": {
          "expiresAt": { "format": "date-time", "type": "string" },
          "fields": { "additionalProperties": { "type": "string" }, "type": "object" },
          "method": { "enum": ["POST"], "type": "string" },
          "url": { "format": "uri", "type": "string" }
        },
        "required": ["method", "url", "fields", "expiresAt"],
        "type": "object"
      },
      "HealthResponseDto": {
        "properties": { "status": { "enum": ["ok"], "example": "ok", "type": "string" } },
        "required": ["status"],
        "type": "object"
      },
      "LoginResponseDto": {
        "properties": {
          "csrfToken": { "type": "string" },
          "expiresAt": { "format": "date-time", "type": "string" },
          "next": {
            "enum": ["AUTHENTICATED", "TOTP_REQUIRED", "TOTP_ENROLLMENT_REQUIRED"],
            "type": "string"
          },
          "provisioningUri": {
            "description": "Controlled TOTP enrollment URI; returned only after a valid staff password.",
            "type": "string"
          },
          "user": { "$ref": "#/components/schemas/SafeUserDto" }
        },
        "required": ["next"],
        "type": "object"
      },
      "MediaAssetDto": {
        "properties": {
          "altTextByLocale": { "additionalProperties": { "type": "string" }, "type": "object" },
          "bytes": { "minimum": 1, "type": "number" },
          "checksum": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
          "createdAt": { "format": "date-time", "type": "string" },
          "createdBy": { "format": "uuid", "type": "string" },
          "derivatives": {
            "items": { "$ref": "#/components/schemas/MediaDerivativeDto" },
            "type": "array"
          },
          "durationSeconds": { "minimum": 0, "nullable": true, "type": "number" },
          "height": { "minimum": 1, "nullable": true, "type": "number" },
          "id": { "format": "uuid", "type": "string" },
          "kind": { "enum": ["IMAGE", "VIDEO"], "type": "string" },
          "mimeType": {
            "enum": [
              "image/jpeg",
              "image/png",
              "image/webp",
              "image/avif",
              "video/mp4",
              "video/webm"
            ],
            "type": "string"
          },
          "updatedAt": { "format": "date-time", "type": "string" },
          "url": { "format": "uri", "nullable": true, "type": "string" },
          "visibility": { "enum": ["PUBLIC", "PRIVATE"], "type": "string" },
          "width": { "minimum": 1, "nullable": true, "type": "number" }
        },
        "required": [
          "id",
          "kind",
          "visibility",
          "mimeType",
          "bytes",
          "width",
          "height",
          "durationSeconds",
          "checksum",
          "altTextByLocale",
          "url",
          "createdBy",
          "createdAt",
          "updatedAt",
          "derivatives"
        ],
        "type": "object"
      },
      "MediaDerivativeDto": {
        "properties": {
          "bytes": { "minimum": 1, "type": "number" },
          "checksum": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
          "format": { "enum": ["webp", "jpg"], "type": "string" },
          "height": { "minimum": 1, "type": "number" },
          "id": { "format": "uuid", "type": "string" },
          "mimeType": { "enum": ["image/webp", "image/jpeg"], "type": "string" },
          "url": { "format": "uri", "nullable": true, "type": "string" },
          "variant": { "enum": ["thumb", "card", "hero", "og"], "type": "string" },
          "width": { "minimum": 1, "type": "number" }
        },
        "required": [
          "id",
          "variant",
          "format",
          "mimeType",
          "width",
          "height",
          "bytes",
          "checksum",
          "url"
        ],
        "type": "object"
      },
      "MediaUploadIntentDto": {
        "properties": {
          "assetId": { "format": "uuid", "type": "string" },
          "expiresAt": { "format": "date-time", "type": "string" },
          "upload": { "$ref": "#/components/schemas/DirectUploadDto" },
          "uploadId": { "format": "uuid", "type": "string" }
        },
        "required": ["uploadId", "assetId", "expiresAt", "upload"],
        "type": "object"
      },
      "PrivateMediaUrlDto": {
        "properties": {
          "expiresAt": { "format": "date-time", "type": "string" },
          "url": { "format": "uri", "type": "string" }
        },
        "required": ["url", "expiresAt"],
        "type": "object"
      },
      "ProblemDetailsDto": {
        "properties": {
          "code": { "example": "VALIDATION_FAILED", "type": "string" },
          "detail": { "example": "The request could not be processed.", "type": "string" },
          "errors": {
            "items": { "$ref": "#/components/schemas/ValidationIssueDto" },
            "type": "array"
          },
          "instance": { "example": "/v1/example", "type": "string" },
          "requestId": { "example": "018f5d36-7b89-7a67-bb7a-e8f9f5db7412", "type": "string" },
          "status": { "example": 422, "type": "number" },
          "title": { "example": "Request validation failed", "type": "string" },
          "type": {
            "example": "https://api.honey.invalid/problems/validation-failed",
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "code", "instance", "requestId"],
        "type": "object"
      },
      "ReadyResponseDto": {
        "properties": {
          "checks": {
            "additionalProperties": false,
            "properties": {
              "database": { "enum": ["ready"], "example": "ready", "type": "string" }
            },
            "required": ["database"],
            "type": "object"
          },
          "status": { "enum": ["ready"], "example": "ready", "type": "string" }
        },
        "required": ["status"],
        "type": "object"
      },
      "SafeUserDto": {
        "properties": {
          "displayName": { "nullable": true, "type": "string" },
          "email": { "format": "email", "type": "string" },
          "emailVerified": { "type": "boolean" },
          "id": { "format": "uuid", "type": "string" },
          "isStaff": { "type": "boolean" },
          "permissions": {
            "items": {
              "enum": [
                "catalog:read",
                "catalog:write",
                "catalog:publish",
                "inventory:read",
                "inventory:adjust",
                "procurement:read",
                "procurement:write",
                "order:read",
                "order:write",
                "order:refund",
                "order:cancel",
                "customer:read",
                "customer:export",
                "content:read",
                "content:write",
                "content:publish",
                "review:moderate",
                "settings:read",
                "settings:write",
                "role:grant",
                "audit:read"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "preferredLocale": { "example": "fa", "type": "string" },
          "roles": {
            "items": {
              "enum": [
                "OWNER",
                "ADMIN",
                "ORDER_MANAGER",
                "INVENTORY_MANAGER",
                "CONTENT_EDITOR",
                "SUPPORT",
                "CUSTOMER"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "status": { "enum": ["ACTIVE", "SUSPENDED", "DELETED"], "type": "string" }
        },
        "required": [
          "id",
          "email",
          "emailVerified",
          "displayName",
          "preferredLocale",
          "status",
          "isStaff",
          "roles",
          "permissions"
        ],
        "type": "object"
      },
      "SessionDto": {
        "properties": {
          "createdAt": { "format": "date-time", "type": "string" },
          "current": { "type": "boolean" },
          "expiresAt": { "format": "date-time", "type": "string" },
          "id": { "format": "uuid", "type": "string" },
          "ip": { "nullable": true, "type": "string" },
          "kind": { "enum": ["CUSTOMER", "STAFF"], "type": "string" },
          "lastSeenAt": { "format": "date-time", "type": "string" },
          "userAgentHash": { "nullable": true, "type": "string" }
        },
        "required": [
          "id",
          "kind",
          "current",
          "createdAt",
          "lastSeenAt",
          "expiresAt",
          "ip",
          "userAgentHash"
        ],
        "type": "object"
      },
      "SessionsResponseDto": {
        "properties": {
          "sessions": { "items": { "$ref": "#/components/schemas/SessionDto" }, "type": "array" }
        },
        "required": ["sessions"],
        "type": "object"
      },
      "ValidationIssueDto": {
        "properties": {
          "code": { "example": "INVALID_VALUE", "type": "string" },
          "path": { "example": "field", "type": "string" }
        },
        "required": ["path", "code"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "description": "Opaque server-side session. Local HTTP development uses honey_session.",
        "in": "cookie",
        "name": "__Host-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Honey API contract. Cookie-authenticated unsafe requests require the X-CSRF-Token double-submit header.",
    "title": "Honey API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Reports whether the HTTP process is alive without querying dependencies.",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponseDto" } }
            },
            "description": "The HTTP process is alive."
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": "An unexpected failure occurred."
          }
        },
        "summary": "Check process liveness",
        "tags": ["Operations"]
      }
    },
    "/readyz": {
      "get": {
        "description": "Reports readiness after a bounded PostgreSQL dependency check.",
        "operationId": "getReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ReadyResponseDto" } }
            },
            "description": "All required dependencies are ready."
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": "An unexpected failure occurred."
          },
          "503": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": "A required dependency is unavailable."
          }
        },
        "summary": "Check required dependencies",
        "tags": ["Operations"]
      }
    },
    "/v1/admin/media/{assetId}": {
      "delete": {
        "description": "Deletes only a media asset that is not protected by an attachment constraint.",
        "operationId": "deleteMediaAsset",
        "parameters": [
          {
            "in": "path",
            "name": "assetId",
            "required": true,
            "schema": { "format": "uuid", "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "" },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": ""
          },
          "409": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": ""
          }
        },
        "security": [{ "sessionCookie": [] }],
        "summary": "Delete an unattached media asset",
        "tags": ["Media"]
      },
      "get": {
        "description": "Returns safe persisted metadata and canonical public URLs only when public.",
        "operationId": "getMediaAsset",
        "parameters": [
          {
            "in": "path",
            "name": "assetId",
            "required": true,
            "schema": { "format": "uuid", "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MediaAssetDto" } }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": ""
          },
          "404": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": ""
          }
        },
        "security": [{ "sessionCookie": [] }],
        "summary": "Get trusted media metadata",
        "tags": ["Media"]
      }
    },
