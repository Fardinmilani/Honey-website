{
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "properties": { "status": { "enum": ["ok"], "example": "ok", "type": "string" } },
        "required": ["status"],
        "type": "object"
      },
      "ProblemDetailsDto": {
        "properties": {
          "code": { "example": "VALIDATION_FAILED", "type": "string" },
          "detail": { "example": "The request could not be processed.", "type": "string" },
          "errors": {
            "items": { "$ref": "#/components/schemas/ValidationIssueDto" },
            "type": "array"
          },
          "instance": { "example": "/v1/example", "type": "string" },
          "requestId": { "example": "018f5d36-7b89-7a67-bb7a-e8f9f5db7412", "type": "string" },
          "status": { "example": 422, "type": "number" },
          "title": { "example": "Request validation failed", "type": "string" },
          "type": {
            "example": "https://api.honey.invalid/problems/validation-failed",
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "code", "instance", "requestId"],
        "type": "object"
      },
      "ReadyResponseDto": {
        "properties": {
          "checks": {
            "additionalProperties": false,
            "properties": {
              "database": { "enum": ["ready"], "example": "ready", "type": "string" }
            },
            "required": ["database"],
            "type": "object"
          },
          "status": { "enum": ["ready"], "example": "ready", "type": "string" }
        },
        "required": ["status"],
        "type": "object"
      },
      "ValidationIssueDto": {
        "properties": {
          "code": { "example": "INVALID_VALUE", "type": "string" },
          "path": { "example": "field", "type": "string" }
        },
        "required": ["path", "code"],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Operational contract for the Honey API foundation.",
    "title": "Honey API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Reports whether the HTTP process is alive without querying dependencies.",
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponseDto" } }
            },
            "description": "The HTTP process is alive."
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": "An unexpected failure occurred."
          }
        },
        "summary": "Check process liveness",
        "tags": ["Operations"]
      }
    },
    "/readyz": {
      "get": {
        "description": "Reports readiness after a bounded PostgreSQL dependency check.",
        "operationId": "getReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ReadyResponseDto" } }
            },
            "description": "All required dependencies are ready."
          },
          "500": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": "An unexpected failure occurred."
          },
          "503": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
            },
            "description": "A required dependency is unavailable."
          }
        },
        "summary": "Check required dependencies",
        "tags": ["Operations"]
      }
    }
  },
  "servers": [],
  "tags": [{ "description": "Process and dependency health endpoints.", "name": "Operations" }]
}
