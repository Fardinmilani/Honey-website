      "post": {
        "description": "Consumes one reset token, replaces the Argon2id credential, and revokes existing sessions.",
        "operationId": "confirmPasswordReset",
        "parameters": [],
        "responses": {
          "204": { "description": "" },
          "409": {
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ProblemDetailsDto" } }
