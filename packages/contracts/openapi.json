    "/v1/auth/email-verification/confirm": {
      "post": {
        "description": "Consumes one valid, unexpired verification token and atomically marks the email verified.",
        "operationId": "confirmEmailVerification",
        "parameters": [],
        "responses": {
          "204": { "description": "" },
