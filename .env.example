# -----------------------------------------------------------------------------
# Runtime mode and public URLs
# -----------------------------------------------------------------------------
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WORKER_HEALTH_PORT=4001
PUBLIC_SITE_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL (planned for Phase 3/4; not connected in Phase 2)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=honey
POSTGRES_USER=honey
POSTGRES_PASSWORD=replace-with-local-development-password
DATABASE_URL=postgresql://honey:replace-with-local-development-password@localhost:5432/honey
DIRECT_DATABASE_URL=postgresql://honey:replace-with-local-development-password@localhost:5432/honey

# -----------------------------------------------------------------------------
# Redis and background jobs (planned for Phase 3/16)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# S3-compatible object storage / MinIO (planned for Phase 3/7)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=honey-media
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Sessions and security (planned for Phase 5/6)
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=honey_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_SECONDS=1209600
CSRF_SECRET=replace-with-at-least-32-random-bytes

# -----------------------------------------------------------------------------
# Payment and shipping adapters (provider remains undecided)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_CREDENTIAL_ID=replace-when-provider-is-selected
PAYMENT_PROVIDER_SECRET=replace-when-provider-is-selected
PAYMENT_CALLBACK_URL=http://localhost:3000/fa/checkout/payment-return
SHIPPING_PROVIDER=manual
SHIPPING_PROVIDER_SECRET=replace-when-provider-is-selected

# -----------------------------------------------------------------------------
# Email and SMS adapters (planned for Phase 18)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.invalid
EMAIL_PROVIDER_API_KEY=replace-when-provider-is-selected
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=replace-when-provider-is-selected
SMS_SENDER_ID=replace-when-provider-is-selected

# -----------------------------------------------------------------------------
# Observability (planned for Phase 19)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
OTEL_SERVICE_NAME=honey-website
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
