# -----------------------------------------------------------------------------
# Runtime mode and public URLs
# -----------------------------------------------------------------------------
NODE_ENV=development
WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=4000
WORKER_HEALTH_PORT=4001
PUBLIC_SITE_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
API_BODY_LIMIT_BYTES=1048576
API_SHUTDOWN_GRACE_MS=10000
API_READINESS_TIMEOUT_MS=2000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# PostgreSQL (local service and Phase 4 Prisma database foundation)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=honey_local
POSTGRES_USER=honey_local
POSTGRES_PASSWORD=replace-with-local-development-password
DATABASE_URL=postgresql://honey_local:replace-with-local-development-password@localhost:5432/honey_local
DATABASE_MIGRATION_URL=postgresql://honey_local:replace-with-local-development-password@localhost:5432/honey_local
DIRECT_DATABASE_URL=postgresql://honey_local:replace-with-local-development-password@localhost:5432/honey_local
TEST_DATABASE_ADMIN_URL=postgresql://honey_local:replace-with-local-development-password@localhost:5432/postgres
SEED_STAFF_EMAIL=owner@example.invalid
SEED_STAFF_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# Redis (local service; background jobs start in Phase 16)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# S3-compatible object storage / MinIO (local service; adapter starts in Phase 7)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=honey-local-minio
MINIO_ROOT_PASSWORD=replace-with-local-development-password
MINIO_PUBLIC_BUCKET=honey-media
MINIO_PRIVATE_BUCKET=honey-private
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=honey-media
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Session settings (planned for Phase 6) and Phase 5 CSRF transport names
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=honey_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_SECONDS=1209600
CSRF_SECRET=replace-with-at-least-32-random-bytes
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=x-csrf-token
CSRF_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Payment and shipping adapters (provider remains undecided)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_CREDENTIAL_ID=replace-when-provider-is-selected
PAYMENT_PROVIDER_SECRET=replace-when-provider-is-selected
PAYMENT_CALLBACK_URL=http://localhost:3000/fa/checkout/payment-return
SHIPPING_PROVIDER=manual
SHIPPING_PROVIDER_SECRET=replace-when-provider-is-selected

# -----------------------------------------------------------------------------
# Mailpit (local SMTP catcher; application email integration starts in Phase 18)
# -----------------------------------------------------------------------------
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# Email and SMS adapters (planned for Phase 18)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.invalid
EMAIL_PROVIDER_API_KEY=replace-when-provider-is-selected
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=replace-when-provider-is-selected
SMS_SENDER_ID=replace-when-provider-is-selected

# -----------------------------------------------------------------------------
# Observability (planned for Phase 19)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
OTEL_SERVICE_NAME=honey-website
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
